---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Requesting AI Research... | Can My Pet Eat This?" description="We are researching this topic.">
	<div class="request-container">
		<div class="request-icon">🔬</div>
		<h1>We're On It!</h1>
		<p>Our AI pet nutritionist hasn't researched this topic yet, but we've added it to the queue.</p>
		
		<div class="status-box">
			<div class="loader"></div>
			<p id="status-text">Analyzing your query...</p>
		</div>

		<a href="/" class="btn-home">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
			Return Home
		</a>
	</div>

	<script>
		async function captureRequest() {
			const urlParams = new URLSearchParams(window.location.search);
			const query = urlParams.get('q');
			
			if (!query) {
				const el = document.getElementById('status-text');
				if (el) el.innerText = "No search term provided.";
				return;
			}

			// Log the query to pending.json via writing to localStorage as fallback
			// (In static mode, we can't hit server API, so we store locally)
			try {
				const existing = JSON.parse(localStorage.getItem('pending_queries') || '[]');
				const isDuplicate = existing.some((item) => item.query === query);
				if (!isDuplicate) {
					existing.push({ query, timestamp: new Date().toISOString() });
					localStorage.setItem('pending_queries', JSON.stringify(existing));
				}
			} catch(e) { /* silently fail */ }

			const statusEl = document.getElementById('status-text');
			if (statusEl) {
				statusEl.innerHTML = `<strong>"${decodeURIComponent(query)}"</strong> has been noted!<br/><br/>Our AI researches new topics every night. Check back tomorrow! 🌙`;
			}
			const loader = document.querySelector('.loader');
			if (loader) (loader as HTMLElement).style.display = 'none';
		}

		captureRequest();
	</script>
</Layout>

<style>
	.request-container {
		text-align: center;
		padding: 100px 20px;
		max-width: 560px;
		margin: 0 auto;
	}
	.request-icon {
		font-size: 4rem;
		margin-bottom: 24px;
		animation: pulse 2s ease-in-out infinite;
	}
	@keyframes pulse {
		0%, 100% { transform: scale(1); }
		50% { transform: scale(1.1); }
	}
	h1 { 
		font-size: 2.5rem; 
		margin-bottom: 16px; 
		background: var(--gradient-hero);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		font-weight: 800;
	}
	p { 
		font-size: 1.1rem; 
		color: var(--text-muted); 
		margin-bottom: 36px; 
		line-height: 1.7;
	}
	.status-box {
		background: var(--card-bg);
		backdrop-filter: blur(16px);
		border: 1px solid var(--border-color);
		border-radius: var(--radius);
		padding: 40px;
		margin-bottom: 36px;
		box-shadow: var(--glass-shadow);
	}
	.loader {
		border: 4px solid var(--border-color);
		border-top: 4px solid var(--primary);
		border-radius: 50%;
		width: 40px;
		height: 40px;
		animation: spin 0.8s linear infinite;
		margin: 0 auto 20px auto;
	}
	@keyframes spin { 
		0% { transform: rotate(0deg); } 
		100% { transform: rotate(360deg); } 
	}
	.btn-home {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 28px;
		background: var(--gradient-hero);
		color: white;
		border-radius: 14px;
		font-weight: 700;
		font-size: 1rem;
		transition: transform 0.15s, box-shadow 0.2s;
	}
	.btn-home:hover { 
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(99, 102, 241, 0.3);
		color: white;
	}
</style>
