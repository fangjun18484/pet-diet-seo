---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';

const schema = JSON.parse(fs.readFileSync('./data/schema.json', 'utf-8'));

const dogs = schema.breeds.filter((b: any) => b.emoji === '🐶');
const cats = schema.breeds.filter((b: any) => b.emoji === '🐱');
---

<Layout title="Can My Pet Eat This? | Safe Pet Diet Guide" description="Discover safe and healthy food choices for your dogs and cats. Search our comprehensive database of pet-safe foods.">
	<header class="hero">
		<span class="hero-badge">🐾 Trusted by Pet Lovers Worldwide</span>
		<h1>Can My Pet Eat This?</h1>
		<p>Search thousands of foods to see if they're safe for your furry friend. Powered by AI pet nutrition experts.</p>
		
		<div class="search-box">
			<input type="text" id="searchInput" placeholder="e.g. Can a Husky eat Strawberries?" />
			<button id="searchBtn">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
				Search
			</button>
		</div>

		<div class="stats-bar">
			<div class="stat"><strong>{schema.breeds.length}</strong> Breeds</div>
			<div class="stat-divider"></div>
			<div class="stat"><strong>{schema.foods.length}</strong> Foods</div>
			<div class="stat-divider"></div>
			<div class="stat"><strong>{schema.breeds.length * schema.foods.length}+</strong> Articles</div>
		</div>
	</header>

	{dogs.length > 0 && (
		<section class="breed-section">
			<h2>🐶 Dog Breeds</h2>
			<div class="grid">
				{dogs.map((breed: any) => (
					<a href={`/${breed.id}`} class="card">
						<span class="card-emoji">{breed.emoji}</span>
						<h3>{breed.name}</h3>
						<p>{schema.foods.length} food guides</p>
					</a>
				))}
			</div>
		</section>
	)}

	{cats.length > 0 && (
		<section class="breed-section">
			<h2>🐱 Cat Breeds</h2>
			<div class="grid">
				{cats.map((breed: any) => (
					<a href={`/${breed.id}`} class="card">
						<span class="card-emoji">{breed.emoji}</span>
						<h3>{breed.name}</h3>
						<p>{schema.foods.length} food guides</p>
					</a>
				))}
			</div>
		</section>
	)}

	<footer class="site-footer">
		<p>© 2025 Can My Pet Eat This? — AI-powered pet nutrition research.</p>
	</footer>
</Layout>

<script define:vars={{ breeds: schema.breeds, foods: schema.foods }}>
	const searchInput = document.getElementById('searchInput');
	const searchBtn = document.getElementById('searchBtn');

	function handleSearch() {
		const query = searchInput.value.trim().toLowerCase();
		if (!query) return;

		const foundBreed = breeds.find(b => query.includes(b.name.toLowerCase()) || query.includes(b.id.replace(/-/g, ' ')));
		const foundFood = foods.find(f => query.includes(f.name.toLowerCase()) || query.includes(f.id.replace(/-/g, ' ')));

		if (foundBreed && foundFood) {
			window.location.href = `/${foundBreed.id}/can-eat-${foundFood.id}`;
		} else {
			window.location.href = `/request?q=${encodeURIComponent(query)}`;
		}
	}

	searchBtn.addEventListener('click', handleSearch);
	searchInput.addEventListener('keydown', (e) => {
		if (e.key === 'Enter') handleSearch();
	});
</script>

<style>
	/* Hero */
	.hero {
		text-align: center;
		padding: 100px 0 60px;
	}
	.hero-badge {
		display: inline-block;
		padding: 8px 20px;
		background: var(--accent-light);
		border: 1px solid rgba(236, 72, 153, 0.2);
		border-radius: 50px;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 24px;
		letter-spacing: 0.02em;
	}
	.hero h1 {
		font-size: clamp(2.5rem, 7vw, 4rem);
		font-weight: 800;
		margin-bottom: 16px;
		letter-spacing: -0.04em;
		background: var(--gradient-hero);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	.hero p {
		font-size: 1.15rem;
		color: var(--text-muted);
		margin-bottom: 36px;
		max-width: 540px;
		margin-left: auto;
		margin-right: auto;
	}

	/* Search */
	.search-box {
		display: flex;
		max-width: 580px;
		margin: 0 auto 32px auto;
		gap: 10px;
	}
	.search-box input {
		flex: 1;
		padding: 16px 24px;
		font-size: 1rem;
		border: 2px solid var(--border-color);
		border-radius: 16px;
		background: var(--card-bg);
		backdrop-filter: blur(8px);
		color: var(--text-main);
		outline: none;
		transition: border-color 0.25s, box-shadow 0.25s;
		font-family: inherit;
	}
	.search-box input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
	}
	.search-box button {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 28px;
		font-size: 1rem;
		font-weight: 700;
		border: none;
		border-radius: 16px;
		background: var(--gradient-hero);
		color: white;
		cursor: pointer;
		transition: transform 0.15s, box-shadow 0.2s;
		font-family: inherit;
		white-space: nowrap;
	}
	.search-box button:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(99, 102, 241, 0.3);
	}
	.search-box button:active {
		transform: translateY(0);
	}

	/* Stats bar */
	.stats-bar {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 24px;
		margin-bottom: 20px;
	}
	.stat {
		font-size: 0.95rem;
		color: var(--text-muted);
	}
	.stat strong {
		color: var(--primary);
		font-weight: 800;
		font-size: 1.1rem;
	}
	.stat-divider {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--border-color);
	}

	/* Breed sections */
	.breed-section {
		margin-bottom: 60px;
	}
	.breed-section h2 {
		font-size: 1.6rem;
		margin-bottom: 24px;
		font-weight: 700;
	}

	/* Grid */
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 16px;
	}

	/* Card overrides for index */
	.card {
		text-align: center;
		padding: 28px 16px;
	}
	.card-emoji {
		font-size: 2.5rem;
		display: block;
		margin-bottom: 12px;
		filter: grayscale(0.2);
		transition: filter 0.3s, transform 0.3s;
	}
	.card:hover .card-emoji {
		filter: grayscale(0);
		transform: scale(1.2) rotate(-5deg);
	}
	.card h3 {
		font-size: 1.05rem;
		margin-bottom: 6px;
		color: var(--text-main);
		font-weight: 700;
	}
	.card p {
		font-size: 0.85rem;
		color: var(--text-muted);
		margin: 0;
	}

	@media (max-width: 640px) {
		.hero { padding: 60px 0 40px; }
		.search-box { flex-direction: column; }
		.search-box button { padding: 14px; justify-content: center; }
		.grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
		.stats-bar { gap: 16px; flex-wrap: wrap; }
	}
</style>
