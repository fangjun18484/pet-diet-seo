---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';

const schema = JSON.parse(fs.readFileSync('./data/schema.json', 'utf-8'));

const dogs = schema.breeds.filter((b: any) => b.emoji === '🐶');
const cats = schema.breeds.filter((b: any) => b.emoji === '🐱');

// Featured breeds to show first (popular ones)
const featuredDogIds = ['golden-retriever', 'french-bulldog', 'german-shepherd', 'labrador-retriever', 'siberian-husky', 'poodle', 'beagle', 'corgi', 'pembroke-welsh-corgi', 'shiba-inu', 'bulldog', 'rottweiler'];
const featuredCatIds = ['persian', 'maine-coon', 'ragdoll', 'british-shorthair', 'siamese', 'bengal', 'sphynx', 'russian-blue'];

const featuredDogs = dogs.filter((d: any) => featuredDogIds.includes(d.id));
const otherDogs = dogs.filter((d: any) => !featuredDogIds.includes(d.id));
const featuredCats = cats.filter((c: any) => featuredCatIds.includes(c.id));
const otherCats = cats.filter((c: any) => !featuredCatIds.includes(c.id));

// Food categories
const foodCategories: Record<string, any[]> = {};
schema.foods.forEach((f: any) => {
  const cat = f.category || 'Other';
  if (!foodCategories[cat]) foodCategories[cat] = [];
  foodCategories[cat].push(f);
});

const categoryEmojis: Record<string, string> = {
  Fruit: '🍎', Vegetable: '🥦', Meat: '🥩', Seafood: '🦐', Protein: '🥚',
  Dairy: '🥛', Grains: '🌾', Snacks: '🍿', Nuts: '🥜', Seeds: '🌻',
  Sweets: '🍬', Drinks: '☕', Spices: '🌿', Condiments: '🧂', 'Junk Food': '🍟'
};
---

<Layout title="Can My Pet Eat This? | Safe Pet Diet Guide" description="Discover safe and healthy food choices for your dogs and cats. Search our comprehensive database of pet-safe foods.">
	<nav class="navbar">
		<a href="/" class="logo">🐾 <span>PetDiet</span></a>
		<div class="nav-links">
			<a href="#dogs">Dogs</a>
			<a href="#cats">Cats</a>
			<a href="#foods">Foods</a>
		</div>
	</nav>

	<header class="hero">
		<span class="hero-badge">🐾 Trusted by Pet Lovers Worldwide</span>
		<h1>Can My Pet Eat This?</h1>
		<p>The internet's most comprehensive pet food safety database. Search any breed + food combo instantly.</p>
		
		<div class="search-box">
			<input type="text" id="searchInput" placeholder="e.g. Can a Husky eat Strawberries?" />
			<button id="searchBtn">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
				Search
			</button>
		</div>

		<div class="stats-bar">
			<div class="stat"><strong>{schema.breeds.length}</strong> Breeds</div>
			<div class="stat-divider"></div>
			<div class="stat"><strong>{schema.foods.length}</strong> Foods</div>
			<div class="stat-divider"></div>
			<div class="stat"><strong>{schema.breeds.length * schema.foods.length}+</strong> Articles</div>
		</div>
	</header>

	<!-- Popular Dogs -->
	<section class="breed-section" id="dogs">
		<div class="section-header">
			<h2>🐶 Popular Dog Breeds</h2>
			<button class="toggle-btn" id="toggleDogs" data-expanded="false">Show all {dogs.length} breeds ↓</button>
		</div>
		<div class="grid">
			{featuredDogs.map((breed: any) => (
				<a href={`/${breed.id}`} class="card">
					<div class="card-icon">🐕</div>
					<h3>{breed.name}</h3>
					<p>{schema.foods.length} food guides</p>
				</a>
			))}
		</div>
		<div class="grid hidden-grid" id="moreDogs">
			{otherDogs.map((breed: any) => (
				<a href={`/${breed.id}`} class="card">
					<div class="card-icon">🐕</div>
					<h3>{breed.name}</h3>
					<p>{schema.foods.length} food guides</p>
				</a>
			))}
		</div>
	</section>

	<!-- Popular Cats -->
	<section class="breed-section" id="cats">
		<div class="section-header">
			<h2>🐱 Popular Cat Breeds</h2>
			<button class="toggle-btn" id="toggleCats" data-expanded="false">Show all {cats.length} breeds ↓</button>
		</div>
		<div class="grid">
			{featuredCats.map((breed: any) => (
				<a href={`/${breed.id}`} class="card">
					<div class="card-icon">🐈</div>
					<h3>{breed.name}</h3>
					<p>{schema.foods.length} food guides</p>
				</a>
			))}
		</div>
		<div class="grid hidden-grid" id="moreCats">
			{otherCats.map((breed: any) => (
				<a href={`/${breed.id}`} class="card">
					<div class="card-icon">🐈</div>
					<h3>{breed.name}</h3>
					<p>{schema.foods.length} food guides</p>
				</a>
			))}
		</div>
	</section>

	<!-- Browse by Food -->
	<section class="breed-section" id="foods">
		<h2>🍽️ Browse by Food Category</h2>
		<div class="food-categories">
			{Object.entries(foodCategories).map(([category, foods]) => (
				<div class="food-cat-card">
					<h3>{categoryEmojis[category] || '🍽️'} {category}</h3>
					<div class="food-tags">
						{(foods as any[]).map((food: any) => (
							<span class="food-tag">{food.name}</span>
						))}
					</div>
				</div>
			))}
		</div>
	</section>

	<footer class="site-footer">
		<p>© 2025 Can My Pet Eat This? — AI-powered pet nutrition research.</p>
	</footer>
</Layout>

<script define:vars={{ breeds: schema.breeds, foods: schema.foods }}>
	const searchInput = document.getElementById('searchInput');
	const searchBtn = document.getElementById('searchBtn');

	function handleSearch() {
		const query = searchInput.value.trim().toLowerCase();
		if (!query) return;
		const foundBreed = breeds.find(b => query.includes(b.name.toLowerCase()) || query.includes(b.id.replace(/-/g, ' ')));
		const foundFood = foods.find(f => query.includes(f.name.toLowerCase()) || query.includes(f.id.replace(/-/g, ' ')));
		if (foundBreed && foundFood) {
			window.location.href = `/${foundBreed.id}/can-eat-${foundFood.id}`;
		} else {
			window.location.href = `/request?q=${encodeURIComponent(query)}`;
		}
	}
	searchBtn.addEventListener('click', handleSearch);
	searchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') handleSearch(); });

	// Toggle show more/less
	function setupToggle(btnId, gridId) {
		const btn = document.getElementById(btnId);
		const grid = document.getElementById(gridId);
		if (!btn || !grid) return;
		btn.addEventListener('click', () => {
			const expanded = btn.dataset.expanded === 'true';
			grid.style.display = expanded ? 'none' : 'grid';
			btn.dataset.expanded = expanded ? 'false' : 'true';
			btn.textContent = expanded ? btn.textContent.replace('Show less ↑', 'Show all') + ' ↓' : 'Show less ↑';
		});
	}
	setupToggle('toggleDogs', 'moreDogs');
	setupToggle('toggleCats', 'moreCats');
</script>

<style>
	/* Navbar */
	.navbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 16px 0;
		border-bottom: 1px solid var(--border-color);
		margin-bottom: 20px;
	}
	.logo {
		font-size: 1.3rem;
		font-weight: 800;
		color: var(--text-main);
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.logo span {
		background: var(--gradient-hero);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.logo:hover { color: var(--text-main); }
	.nav-links {
		display: flex;
		gap: 24px;
	}
	.nav-links a {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--text-muted);
		transition: color 0.2s;
	}
	.nav-links a:hover { color: var(--primary); }

	/* Hero */
	.hero {
		text-align: center;
		padding: 60px 0 50px;
	}
	.hero-badge {
		display: inline-block;
		padding: 8px 20px;
		background: var(--accent-light);
		border: 1px solid rgba(236, 72, 153, 0.2);
		border-radius: 50px;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 24px;
	}
	.hero h1 {
		font-size: clamp(2.5rem, 7vw, 4rem);
		font-weight: 800;
		margin-bottom: 16px;
		letter-spacing: -0.04em;
		background: var(--gradient-hero);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	.hero p {
		font-size: 1.1rem;
		color: var(--text-muted);
		margin-bottom: 36px;
		max-width: 520px;
		margin-left: auto;
		margin-right: auto;
	}

	/* Search */
	.search-box {
		display: flex;
		max-width: 580px;
		margin: 0 auto 28px auto;
		gap: 10px;
	}
	.search-box input {
		flex: 1;
		padding: 16px 24px;
		font-size: 1rem;
		border: 2px solid var(--border-color);
		border-radius: 16px;
		background: var(--card-bg);
		backdrop-filter: blur(8px);
		color: var(--text-main);
		outline: none;
		transition: border-color 0.25s, box-shadow 0.25s;
		font-family: inherit;
	}
	.search-box input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
	}
	.search-box button {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 28px;
		font-size: 1rem;
		font-weight: 700;
		border: none;
		border-radius: 16px;
		background: var(--gradient-hero);
		color: white;
		cursor: pointer;
		transition: transform 0.15s, box-shadow 0.2s;
		font-family: inherit;
		white-space: nowrap;
	}
	.search-box button:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(99, 102, 241, 0.3);
	}

	/* Stats */
	.stats-bar {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 24px;
	}
	.stat { font-size: 0.95rem; color: var(--text-muted); }
	.stat strong { color: var(--primary); font-weight: 800; font-size: 1.1rem; }
	.stat-divider { width: 4px; height: 4px; border-radius: 50%; background: var(--border-color); }

	/* Sections */
	.breed-section { margin-bottom: 48px; }
	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 20px;
		flex-wrap: wrap;
		gap: 12px;
	}
	.section-header h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }
	.toggle-btn {
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 50px;
		padding: 8px 20px;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--primary);
		cursor: pointer;
		transition: background 0.2s, transform 0.15s;
		font-family: inherit;
	}
	.toggle-btn:hover { transform: translateY(-1px); background: rgba(99, 102, 241, 0.06); }

	.breed-section h2 {
		font-size: 1.5rem;
		margin-bottom: 20px;
		font-weight: 700;
	}

	/* Grid */
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
		gap: 14px;
	}
	.hidden-grid { display: none; margin-top: 14px; }

	/* Cards */
	.card { text-align: center; padding: 24px 12px; }
	.card-icon {
		font-size: 2rem;
		margin-bottom: 10px;
		display: block;
		transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.card:hover .card-icon { transform: scale(1.25) rotate(-8deg); }
	.card h3 { font-size: 0.95rem; margin-bottom: 4px; color: var(--text-main); font-weight: 700; }
	.card p { font-size: 0.78rem; color: var(--text-muted); margin: 0; }

	/* Food Categories */
	.food-categories {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 16px;
	}
	.food-cat-card {
		background: var(--card-bg);
		backdrop-filter: blur(16px);
		border: 1px solid var(--border-color);
		border-radius: var(--radius);
		padding: 20px;
		box-shadow: var(--glass-shadow);
	}
	.food-cat-card h3 {
		font-size: 1rem;
		font-weight: 700;
		margin-bottom: 12px;
		color: var(--text-main);
	}
	.food-tags { display: flex; flex-wrap: wrap; gap: 6px; }
	.food-tag {
		display: inline-block;
		padding: 4px 12px;
		background: rgba(99, 102, 241, 0.06);
		border: 1px solid rgba(99, 102, 241, 0.1);
		border-radius: 50px;
		font-size: 0.78rem;
		color: var(--text-muted);
		font-weight: 500;
	}

	@media (max-width: 640px) {
		.hero { padding: 40px 0 30px; }
		.search-box { flex-direction: column; }
		.search-box button { padding: 14px; justify-content: center; }
		.grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
		.stats-bar { gap: 16px; flex-wrap: wrap; }
		.navbar { flex-direction: column; gap: 12px; }
		.food-categories { grid-template-columns: 1fr; }
	}
</style>
