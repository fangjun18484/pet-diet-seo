---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';

export async function getStaticPaths() {
  const schema = JSON.parse(fs.readFileSync('./data/schema.json', 'utf-8'));
  return schema.breeds.map((b: any) => ({
    params: { breed: b.id },
    props: { breedName: b.name, emoji: b.emoji, schema }
  }));
}

const { breed } = Astro.params;
const { breedName, emoji, schema } = Astro.props;

// Fetch all markdown files that have been generated using Vite's glob import
const allPosts = Object.values(import.meta.glob('../*/*.md', { eager: true })) as any[];
// Filter for the current breed
const breedPosts = allPosts.filter(post => post.file.includes(`/${breed}/`));
---

<Layout title={`${breedName} Diet Guide ${emoji}`} description={`Find out what foods are safe and dangerous for your ${breedName}.`}>
  <header class="hero">
    <h1>{breedName} Diet Guide {emoji}</h1>
    <p>Browse our complete database of what your {breedName} can and cannot eat.</p>
    
    <div class="search-box">
      <input type="text" id="searchInput" placeholder={`e.g. Can my ${breedName} eat bananas?`} />
      <button id="searchBtn">Search</button>
    </div>

    <a href="/" class="back-link">← Back to all breeds</a>
  </header>

  <section class="popular">
    <div class="grid">
      {breedPosts.map(post => (
        <a href={post.url} class="card">
          <h3>{post.frontmatter.title}</h3>
          <p>{post.frontmatter.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<script define:vars={{ breeds: schema.breeds, foods: schema.foods, currentBreedId: breed, currentBreedName: breedName }}>
	const searchInput = document.getElementById('searchInput');
	const searchBtn = document.getElementById('searchBtn');

	function handleSearch() {
		let query = searchInput.value.trim().toLowerCase();
		if (!query) return;

		let foundBreed = breeds.find(b => query.includes(b.name.toLowerCase()) || query.includes(b.id.replace(/-/g, ' ')));
        // If the user didn't specify a breed, assume they mean the breed of the current page
        if (!foundBreed) {
            foundBreed = breeds.find(b => b.id === currentBreedId);
            query = currentBreedName.toLowerCase() + " " + query; // enrich query for request logging
        }

		const foundFood = foods.find(f => query.includes(f.name.toLowerCase()) || query.includes(f.id.replace(/-/g, ' ')));

		if (foundBreed && foundFood) {
			window.location.href = `/${foundBreed.id}/can-eat-${foundFood.id}`;
		} else {
			window.location.href = `/request?q=${encodeURIComponent(query)}`;
		}
	}

	searchBtn.addEventListener('click', handleSearch);
	searchInput.addEventListener('keydown', (e) => {
		if (e.key === 'Enter') handleSearch();
	});
</script>

<style>
	.hero {
		text-align: center;
		padding: 60px 0 40px;
	}
	.hero h1 {
		font-size: 3rem;
		font-weight: 700;
		margin-bottom: 16px;
		background: linear-gradient(135deg, var(--primary), #8B5CF6);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.hero p {
		font-size: 1.2rem;
		color: var(--text-muted);
		margin-bottom: 24px;
	}
	.search-box {
		display: flex;
		max-width: 600px;
		margin: 0 auto 24px auto;
		gap: 12px;
	}
	.search-box input {
		flex: 1;
		padding: 16px 24px;
		font-size: 1.1rem;
		border: 1px solid var(--border-color);
		border-radius: 50px;
		background: var(--card-bg);
		color: var(--text-main);
		outline: none;
		transition: border-color 0.2s, box-shadow 0.2s;
	}
	.search-box input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
	}
	.search-box button {
		padding: 0 32px;
		font-size: 1.1rem;
		font-weight: 600;
		border: none;
		border-radius: 50px;
		background: var(--primary);
		color: white;
		cursor: pointer;
		transition: background 0.2s, transform 0.1s;
	}
	.search-box button:hover {
		background: var(--primary-hover);
		transform: translateY(-2px);
	}
	.back-link {
		display: inline-block;
		font-weight: 600;
		margin-bottom: 40px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 20px;
	}
	.card {
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: var(--radius);
		padding: 24px;
		display: block;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 24px rgba(0,0,0,0.05);
	}
	.card h3 {
		font-size: 1.2rem;
		margin-bottom: 8px;
		color: var(--text-main);
	}
	.card p {
		color: var(--text-muted);
	}
</style>
